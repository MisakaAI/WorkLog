# Go reads environment variables, not this file automatically.
# Go 程序不会自动读取此文件中的配置，而是读取环境变量。
# Local shell: cp .env.example .env; edit; set -a; . ./.env; set +a
# 本地 Shell 使用方法：复制为 .env 并编辑，然后执行 set -a; . ./.env; set +a 加载配置。
WORKLOG_ADDR=127.0.0.1:12450
WORKLOG_DB_DRIVER=sqlite
WORKLOG_DB_DSN=./data/worklog.db
WORKLOG_USER_ID=owner
WORKLOG_TIMEZONE=Asia/Shanghai
# Dedicated front-end build directory only, never source/data/backup directories.
# 这里只能填写专用的前端构建产物目录，不要使用源码、数据或备份目录。
WORKLOG_STATIC_DIR=Web/dist
WORKLOG_ALLOWED_HOSTS=localhost,127.0.0.1,::1
WORKLOG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Empty in loopback mode: create/read this 0600 file automatically.
# 回环地址模式下留空时，程序会自动创建或读取此文件，并将权限设为 0600。
WORKLOG_TOKEN_FILE=./data/mcp-token
# Bearer REST writes never grant destructive permission; Basic remains the human channel.
# REST 的 Bearer 写令牌不授予删除等破坏性操作权限；人工操作仍使用 Basic 认证。
WORKLOG_WRITE_TOKEN=
# Optional separate, 32+ byte read-only MCP/REST token.
# 可选的独立只读 MCP/REST 令牌，长度至少为 32 字节。
WORKLOG_READ_TOKEN=
WORKLOG_BASIC_USER=worklog
WORKLOG_BASIC_PASSWORD=
# MCP/stdio operator policy, never a tool argument. Does not enable REST Bearer deletion.
# MCP/stdio 操作者策略配置，不接受作为工具参数传入；不会开放 REST Bearer 删除权限。
# Local anonymous REST is intentionally not a process/agent security boundary.
# 本地 REST 匿名访问仅为便利设计，不构成进程或智能体之间的安全边界。
WORKLOG_MCP_ALLOW_DESTRUCTIVE=false
WORKLOG_STDIO_READ_ONLY=false

# Remote bind / Docker MUST set WRITE_TOKEN (32+ bytes), BASIC_PASSWORD (8+ bytes).
# 绑定非回环地址或使用 Docker 时，必须设置 WRITE_TOKEN（至少 32 字节）和 BASIC_PASSWORD（至少 8 字节）。
# Use e.g. openssl rand -hex 32 for each independent secret; NEVER commit .env.
# 可用 openssl rand -hex 32 等方式分别生成独立密钥；绝不要将 .env 提交到版本库。
# Docker also sets ADDR=0.0.0.0:12450 and STATIC_DIR=/app/web.
# Docker 部署还需设置 ADDR=0.0.0.0:12450 和 STATIC_DIR=/app/web。
# WORKLOG_ALLOWED_HOSTS=worklog.example.com,localhost,127.0.0.1
# 将 worklog.example.com 替换为实际域名，并加入允许访问的主机名。
# WORKLOG_ALLOWED_ORIGINS=https://worklog.example.com
# 将此项设置为实际网站的 HTTPS Origin（协议和域名），不要附带路径。

# PostgreSQL alternative (do not enable for SQLite):
# PostgreSQL 数据库配置示例（使用 SQLite 时不要启用）：
# WORKLOG_DB_DRIVER=postgres
# WORKLOG_DB_DSN=postgres://worklog:URL_SAFE_PASSWORD@127.0.0.1:5432/worklog?sslmode=verify-full
# Compose's internal PostgreSQL initialization:
# Docker Compose 初始化内部 PostgreSQL 数据库时使用：
# WORKLOG_POSTGRES_PASSWORD=INDEPENDENT_URL_SAFE_SECRET
